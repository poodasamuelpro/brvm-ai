# Application
ENVIRONNEMENT=developpement
VERSION_APPLICATION=0.1.0
NIVEAU_JOURNALISATION=INFO

# PostgreSQL (laisser désactivé tant que la base n'est pas configurée)
ACTIVER_BASE_DE_DONNEES=false
BASE_DE_DONNEES_URL=

# API interne / données de marché
ACTIVER_API_INTERNE=false
URL_API=
CLE_API_INTERNE=
ACTIVER_API_DONNEES_MARCHE=false
CLE_API_DONNEES_MARCHE=

# Email SMTP
ACTIVER_EMAIL=false
EMAIL_HOTE=
EMAIL_PORT=587
EMAIL_UTILISATEUR=
EMAIL_MOT_DE_PASSE=
EMAIL_EXPEDITEUR=

# Telegram (configuration uniquement à ce stade)
ACTIVER_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Fournisseur IA (configuration uniquement à ce stade)
ACTIVER_IA=false
FOURNISSEUR_IA=
CLE_API_IA=
MODELE_IA=

# Sécurité: en production, fournir une valeur aléatoire d'au moins 32 caractères
CLE_SECRETE=

# Traitements planifiés
FREQUENCE_COLLECTE_MINUTES=1440
FUSEAU_HORAIRE=Africa/Abidjan
NOMBRE_MAX_TENTATIVES=3
